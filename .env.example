# ------------------------------------------------------------------
# Portfolio API — environment template.
# Copy to .env.local and fill in the values you need. Dev works with
# ZERO of these set — every var has a sensible default in
# apps/api/src/main/resources/application.yml. Prod boot refuses to
# start when the highlighted vars are missing (see comments).
# ------------------------------------------------------------------

# ---- Runtime ----
# 'dev'  = H2 file DB, mock payment, verbose logging (default when unset).
# 'prod' = MySQL, strict boot checks (no weak defaults), real payment
#          providers, minimal logging.
SPRING_PROFILES_ACTIVE=dev

# HTTP port the API listens on. Frontend proxy expects 9090 by default.
PORT=9090

# ---- Admin credentials ----
# Sign in at /admin/login with these. Prod refuses to boot with the
# weak defaults ("changeme" / "123456" / "password" / "admin").
APP_ADMIN_EMAIL=you@yourdomain.com
APP_ADMIN_PASSWORD=

# ---- Storage ----
# Where product ZIPs, product demo images, and the admin CV PDF land
# on disk. Default is apps/api/.storage/ inside the repo (great for
# dev, no setup). Prod: point at a persistent volume you back up.
APP_STORAGE_DIR=

# ---- Site metadata (for absolute URLs) ----
# Used by the dynamic sitemap, order-confirmation email download links,
# and the Stripe success_url. Prefer setting site.baseUrl from the
# /admin/settings panel; this env var is the fallback when that's blank.
SITE_BASE_URL=https://yourdomain.com

# ---- Contact form ----
# Salt for the SHA-256 hash of submitter IPs (so a leaked DB dump can't
# be rainbow-tabled to raw IPs). MUST be set in prod — the app refuses
# to boot with the default "portfolio-salt" under SPRING_PROFILES_ACTIVE=prod.
APP_CONTACT_IP_SALT=
CONTACT_NOTIFY_TO=you@yourdomain.com
CONTACT_FROM=no-reply@yourdomain.com

# ---- Rate-limiting ----
# Only enable X-Forwarded-For trust when running behind a reverse
# proxy (Nginx, Cloudflare, Caddy, etc.) — otherwise clients can spoof
# their IP and evade the admin-login brute-force cap.
TRUST_FORWARDED_FOR=false
TRUSTED_PROXIES=

# ---- Database (prod / mysql profile) ----
DB_URL=jdbc:mysql://localhost:3306/portfolio
DB_USER=portfolio
DB_PASSWORD=

# ---- Payment gateways ----
# Leave blank to keep the stub providers active (dev flow via the
# mock endpoint). Also enter these into /admin/settings so an admin
# can rotate them without a redeploy. Env vars are the fallback.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Email (SMTP) ----
# SendGrid example — replace with your provider's SMTP details.
# When MAIL_PASSWORD is empty, EmailService no-ops (logs the body
# instead of sending). Contact form + order confirmation both flow
# through EmailService.
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=

# ---- CORS (prod behind a domain) ----
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
