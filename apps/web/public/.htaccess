# Hostinger / Apache SPA routing — every non-asset URL falls back to index.html
# so React Router controls the route. Static assets are served as-is.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Skip rewriting for real files / directories (assets, favicon, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else → index.html (React Router takes over)
  RewriteRule ^ index.html [L]
</IfModule>

# Long cache for Vite's hashed assets — content-addressed so safe to cache forever
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|svg|woff2|webp|png|jpg|jpeg|gif|ico|map)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # index.html should always revalidate so new deploys propagate
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# gzip / brotli where available
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Force HTTPS (if cert is installed)
<IfModule mod_rewrite.c>
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
