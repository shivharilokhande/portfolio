# Cloudflare Pages routing.
# Static files (portfolio/, og.jpg, llms.txt, robots.txt, sitemap.xml, assets/) are served first.
# Everything else falls back to the SPA shell; unknown routes render NotFoundPage (noindex).
# NOTE: Pages does NOT support per-route "/index.html 200" rewrites (it 308s to "/"), so the
# splat fallback below is the only working SPA pattern here.
/portfolio      /portfolio/index.html   200
/*              /index.html             200
