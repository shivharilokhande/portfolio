# Cloudflare Pages routing.
# Static files (portfolio/, og.jpg, llms.txt, robots.txt, sitemap.xml, assets/) are served first.
# The SPA shell is served ONLY for known routes so unknown URLs return a real 404 (404.html).
/portfolio          /portfolio/index.html   200
/portfolio/         /portfolio/index.html   200
/store              /index.html   200
/store/*            /index.html   200
/legal/*            /index.html   200
/admin              /index.html   200
/admin/*            /index.html   200
