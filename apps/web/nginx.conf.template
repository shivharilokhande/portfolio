# nginx.conf.template — rendered by nginx-alpine's built-in envsubst
# at container start. Only $API_UPSTREAM is interpolated; every other
# `$var` here is standard nginx and left alone.

server {
  listen       80;
  listen  [::]:80;
  server_name  _;

  # Gzip everything worth compressing. Vite emits pre-hashed filenames,
  # so we can safely cache-forever on static assets.
  gzip                on;
  gzip_types          text/plain text/css application/json application/javascript application/xml image/svg+xml;
  gzip_min_length     1024;
  client_max_body_size 220m;  # matches spring.servlet.multipart.max-request-size

  # Reverse-proxy /api/*, /sitemap.xml (dynamic), /actuator/health.
  location /api/ {
    proxy_pass         ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header   Host              $host;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
    # Payment webhooks arrive as POST — don't buffer, don't retry.
    proxy_buffering    off;
    proxy_request_buffering off;
  }
  location = /sitemap.xml {
    proxy_pass         ${API_UPSTREAM}/sitemap.xml;
    proxy_set_header   Host $host;
  }
  location = /actuator/health {
    proxy_pass         ${API_UPSTREAM}/actuator/health;
    proxy_set_header   Host $host;
  }

  # Static assets — content-addressed by Vite, cache forever.
  location /assets/ {
    root       /usr/share/nginx/html;
    expires    1y;
    add_header Cache-Control "public, immutable";
    try_files  $uri =404;
  }

  # SPA fallback — every unknown path returns index.html so
  # react-router can take over.
  location / {
    root  /usr/share/nginx/html;
    try_files $uri /index.html;
    add_header Cache-Control "no-cache";
  }
}
